spring.application.name=clothes-shop-backend
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/clothes_shop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

app.jwt.secret=replace_with_a_very_long_random_secret_key_at_least_32_chars
app.jwt.expiration-ms=86400000
